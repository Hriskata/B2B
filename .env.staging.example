# TEST SERVER (staging). Copy to .env.staging ON THE SERVER and fill in.
# Never commit .env.staging. Every secret here must differ from production:
#   npm run check:env -- --kind staging --file .env.staging --other .env.production
# Here new features are tried (with sample data) before they go to production.

POSTGRES_DB=b2b
POSTGRES_USER=b2b
# Random, at least 20 characters: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# Port on 127.0.0.1 for the reverse proxy (production uses another one).
APP_PORT=3100

# Address of the test server, https only (for example https://test.your-domain.bg).
APP_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Mail: a real provider or a sandbox mailbox of it. NOT Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudflare Turnstile keys made for the test domain (not the public test keys).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Number of reverse proxies in front of the app.
TRUSTED_PROXY_COUNT=1

# Leave empty on the test server: test visits must not reach the real statistics.
GA_MEASUREMENT_ID=
