# Copy to .env and fill in. Never commit .env.
# Use a fresh local password; never reuse production values here.

POSTGRES_DB=b2b
POSTGRES_USER=b2b
POSTGRES_PASSWORD=

# For `npm run dev`, `npm run db:migrate` and `npm run admin:create` on the host (compose overrides this for containers).
DATABASE_URL=postgres://b2b:<POSTGRES_PASSWORD>@127.0.0.1:5432/b2b

# --- Application (used by the app container and by `npm run dev`) ---
# Public base URL. Cookies are Secure (with the __Host- prefix) when this is https.
APP_URL=http://localhost:3200
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Mail: in the local Docker setup mails go to Mailpit (UI: http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="B2B каталог <noreply@b2b.example>"
# Cloudflare Turnstile TEST keys (public, from Cloudflare's docs): always pass.
# Never use production keys here.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Number of reverse proxies that append to X-Forwarded-For in front of the app.
TRUSTED_PROXY_COUNT=1
# Integration tests only. The database name MUST end with _test (it gets wiped).
TEST_DATABASE_URL=postgres://b2b:<POSTGRES_PASSWORD>@127.0.0.1:5432/b2b_test

# LOCAL TESTING ONLY: true lets admins log in with the password alone (no 2FA).
# The app refuses to start with this on unless APP_URL is http://localhost or http://127.0.0.1.
ADMIN_2FA_DISABLED=false

# Optional: Google Analytics 4 id (G-XXXXXXXXXX). Leave empty for none. It loads only after the visitor accepts cookies.
GA_MEASUREMENT_ID=
