# Copy to .env and fill in. Never commit .env.
# Use a fresh local password; never reuse production values here.

POSTGRES_DB=b2b
POSTGRES_USER=b2b
POSTGRES_PASSWORD=

# For `npm run dev` / `npm run db:migrate` on the host against the compose database.
DATABASE_URL=postgres://b2b:<POSTGRES_PASSWORD>@127.0.0.1:5432/b2b
