# OFFICIAL SITE (production). Copy to .env.production ON THE SERVER and fill in.
# Never commit .env.production, never copy it to a laptop or to the test server.
# Every secret here must be different from staging:
#   npm run check:env -- --kind production --file .env.production --other .env.staging

POSTGRES_DB=b2b
POSTGRES_USER=b2b
# Random, at least 20 characters: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# Port on 127.0.0.1 for the reverse proxy (staging uses another one).
APP_PORT=3000

# Address of the official site, https only (for example https://www.your-domain.bg).
APP_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy together with the database backups: without it the admins' 2FA secrets cannot be read.
TOTP_ENCRYPTION_KEY=

# Mail: the production provider (SPF, DKIM and DMARC set for the sender domain).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudflare Turnstile keys made for the official domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Number of reverse proxies in front of the app.
TRUSTED_PROXY_COUNT=1

# Google Analytics 4 id (G-XXXXXXXXXX). It loads only after the visitor accepts cookies. Empty = none.
GA_MEASUREMENT_ID=
